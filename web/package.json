{
  "name": "unrack-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WebHID control app + protocol codec for the t.racks DSP 4x4 Mini Pro",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:esp": "node --experimental-strip-types tools/build-esp.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --experimental-strip-types --test 'test/*.test.ts'",
    "hw:smoke": "node --experimental-strip-types tools/hw-smoke.ts",
    "hw:latency": "node --experimental-strip-types tools/latency.ts",
    "capture:demo": "node --experimental-strip-types tools/capture-demo.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^25.9.3",
    "@types/w3c-web-hid": "^1.0.7",
    "playwright-core": "1.64.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
